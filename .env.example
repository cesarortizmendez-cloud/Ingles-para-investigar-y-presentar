# Variables de entorno. En local no hace falta ninguna (usa SQLite y DEBUG).
# En Vercel: Settings → Environment Variables (Production y Preview).

# Obligatoria en producción: clave larga y secreta. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Base de datos Neon: al conectar Neon desde Vercel (Storage) se crean solas
#   DATABASE_URL (con pooler, la usa la app) y DATABASE_URL_UNPOOLED (directa, para migraciones).
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Administrador que se crea en el primer despliegue (opcional)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Dominio propio (opcional, separado por comas). *.vercel.app ya está permitido.
ALLOWED_HOSTS=

TUTOR_PROVIDER=simulated
